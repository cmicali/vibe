#ifdef __OBJC__

#import <AppKit/AppKit.h>
#import <Foundation/Foundation.h>
#import <QuartzCore/QuartzCore.h>

#import <os/log.h>

#import "AppSettings.h"
#import "HelperMacros.h"

static inline os_log_t VibeLog(void) {
    static os_log_t log;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        log = os_log_create("com.commonwealthrecordings.Vibe", "app");
    });
    return log;
}

// os_log requires a compile-time constant format string, so messages are
// pre-formatted with NSString. %{public} keeps them readable in Console
// (os_log redacts dynamic strings by default). The enabled check is what
// makes disabled levels free: without it the stringWithFormat: runs
// unconditionally — info/debug are off-stream by default, so every LogDebug
// on a hot path would pay full ObjC formatting for a discarded message.
#define VibeLogAt(type, fmt, ...)                                                              \
    do {                                                                                       \
        if (os_log_type_enabled(VibeLog(), type)) {                                            \
            os_log_with_type(VibeLog(), type, "%{public}@",                                    \
                             [NSString stringWithFormat:(fmt), ##__VA_ARGS__]);                \
        }                                                                                      \
    } while (0)

#define LogError(fmt, ...)  VibeLogAt(OS_LOG_TYPE_ERROR, fmt, ##__VA_ARGS__)
#define LogWarn(fmt, ...)   VibeLogAt(OS_LOG_TYPE_DEFAULT, fmt, ##__VA_ARGS__)
#define LogInfo(fmt, ...)   VibeLogAt(OS_LOG_TYPE_INFO, fmt, ##__VA_ARGS__)
#define LogDebug(fmt, ...)  VibeLogAt(OS_LOG_TYPE_DEBUG, fmt, ##__VA_ARGS__)

#define Settings [AppSettings sharedInstance]

#endif
