{
  "sourceLanguage": "en",
  "strings": {
    "widget.description": {
      "comment": "iOS widget gallery: the one-line description under the Now Playing widget's name, shown while the user is choosing a widget to add. Vibe is the app name.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво възпроизвежда Vibe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co Vibe přehrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad Vibe afspiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Vibe gerade abspielt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι αναπαράγει το Vibe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Vibe is playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que está reproduciendo Vibe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä Vibe toistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Vibe est en train de lire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što Vibe reproducira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit a Vibe lejátszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang sedang diputar Vibe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa sta riproducendo Vibe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibeで再生中の曲。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe에서 재생 중인 항목."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva Vibe spiller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat Vibe afspeelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co odtwarza Vibe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Vibe está reproduzindo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Vibe está a reproduzir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce redă Vibe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что воспроизводит Vibe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo Vibe prehráva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad Vibe spelar upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ Vibe กำลังเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe’ın çaldığı parça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що відтворює Vibe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe đang phát gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe 正在播放的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe 正在播放的內容。"
          }
        }
      },
      "extractionState": "manual"
    },
    "widget.description.waveform": {
      "comment": "iOS widget gallery: the description under the Waveform widget's name. Seek means jump to a position in the track.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Песента и нейната вълнова форма. Докоснете вълновата форма, за да превъртите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba a její tvar vlny. Klepnutím na tvar vlny přetočíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummeret og dets bølgeform. Tryk på bølgeformen for at spole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel und seine Wellenform. Tippe auf die Wellenform, um zu spulen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κομμάτι και η κυματομορφή του. Αγγίξτε την κυματομορφή για μετάβαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The track and its waveform. Tap the waveform to seek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La canción y su forma de onda. Toca la forma de onda para desplazarte por la canción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappale ja sen aaltomuoto. Siirry kappaleessa napauttamalla aaltomuotoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le morceau et sa forme d’onde. Touchez la forme d’onde pour vous déplacer dans le morceau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pjesma i njezin valni oblik. Dodirnite valni oblik za premotavanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szám és a hullámformája. Koppints a hullámformára a tekeréshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu dan bentuk gelombangnya. Ketuk bentuk gelombang untuk mencari posisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il brano e la sua forma d’onda. Tocca la forma d’onda per spostarti nel brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲とその波形。波形をタップしてシークします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙과 파형. 파형을 탭하여 탐색합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporet og bølgeformen. Trykk på bølgeformen for å spole."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nummer en de golfvorm. Tik op de golfvorm om te spoelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwór i jego kształt fali. Stuknij kształt fali, aby przewinąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa e sua forma de onda. Toque na forma de onda para avançar ou voltar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa e a respetiva forma de onda. Toque na forma de onda para avançar ou recuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesa și forma ei de undă. Atingeți forma de undă pentru a derula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трек и его волновая форма. Коснитесь волновой формы, чтобы перемотать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba a jej vlnový priebeh. Klepnutím na vlnový priebeh pretočíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spåret och dess vågform. Tryck på vågformen för att spola."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทร็กและรูปคลื่นของแทร็ก แตะรูปคลื่นเพื่อเลื่อนหา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parça ve dalga biçimi. Sarmak için dalga biçimine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трек і його хвильова форма. Торкніться хвильової форми, щоб перемотати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài hát và dạng sóng của bài. Chạm vào dạng sóng để tua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲目及其波形。轻点波形即可跳转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曲目及其波形。點一下波形即可跳轉。"
          }
        }
      },
      "extractionState": "manual"
    },
    "widget.description.waveform_player": {
      "comment": "iOS widget gallery: the description under the Waveform Player widget's name. Play/pause is the button that starts and stops playback.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Песента, нейната вълнова форма и пускане/пауза."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba, její tvar vlny a přehrávání/pozastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummeret, dets bølgeform og afspil/pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel, seine Wellenform und Abspielen/Pause."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κομμάτι, η κυματομορφή του και αναπαραγωγή/παύση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The track, its waveform, and play/pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La canción, su forma de onda y reproducir/pausa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappale, sen aaltomuoto ja toisto/keskeytys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le morceau, sa forme d’onde et lecture/pause."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pjesma, njezin valni oblik i reprodukcija/pauza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szám, a hullámformája és a lejátszás/szünet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu, bentuk gelombangnya, dan putar/jeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il brano, la sua forma d’onda e riproduci/pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲、波形、再生/一時停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙, 파형, 재생/일시 정지."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporet, bølgeformen og spill av/pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nummer, de golfvorm en afspelen/pauzeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwór, jego kształt fali oraz odtwarzanie/wstrzymanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa, sua forma de onda e reproduzir/pausar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa, a respetiva forma de onda e reproduzir/pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesa, forma ei de undă și redare/pauză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трек, его волновая форма и воспроизведение/пауза."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba, jej vlnový priebeh a prehrávanie/pozastavenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spåret, dess vågform och spela upp/pausa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทร็ก รูปคลื่น และเล่น/หยุดพัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parça, dalga biçimi ve çal/duraklat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трек, його хвильова форма і відтворення/пауза."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài hát, dạng sóng và phát/tạm dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲目、波形以及播放/暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曲目、波形以及播放/暫停。"
          }
        }
      },
      "extractionState": "manual"
    },
