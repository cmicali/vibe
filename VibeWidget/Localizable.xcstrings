{
  "sourceLanguage": "en",
  "strings": {
    "widget.description": {
      "comment": "iOS widget gallery: the one-line description under the widget's name, shown while the user is choosing a widget to add. Vibe is the app name.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво възпроизвежда Vibe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co Vibe přehrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad Vibe afspiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Vibe gerade abspielt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι αναπαράγει το Vibe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Vibe is playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que está reproduciendo Vibe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä Vibe toistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Vibe est en train de lire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što Vibe reproducira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit a Vibe lejátszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang sedang diputar Vibe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa sta riproducendo Vibe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibeで再生中の曲。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe에서 재생 중인 항목."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva Vibe spiller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat Vibe afspeelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co odtwarza Vibe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Vibe está reproduzindo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Vibe está a reproduzir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce redă Vibe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что воспроизводит Vibe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo Vibe prehráva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad Vibe spelar upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ Vibe กำลังเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe’ın çaldığı parça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що відтворює Vibe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe đang phát gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe 正在播放的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe 正在播放的內容。"
          }
        }
      },
      "extractionState": "manual"
    },
    "widget.empty.click": {
      "comment": "Mac desktop widget, shown when nothing is playing, where the track title would be: clicking the widget opens the app. Vibe is the app name. Keep it short — it sits beside a small artwork tile.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Щракнете, за да отворите Vibe"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím otevřete Vibe"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik for at åbne Vibe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um Vibe zu öffnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ για να ανοίξετε το Vibe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to open Vibe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para abrir Vibe"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Vibe osoittamalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour ouvrir Vibe"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite za otvaranje aplikacije Vibe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattints a Vibe megnyitásához"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik untuk membuka Vibe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per aprire Vibe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックしてVibeを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하여 Vibe 열기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk for å åpne Vibe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik om Vibe te openen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, aby otworzyć Vibe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para abrir o Vibe"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para abrir o Vibe"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pentru a deschide Vibe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы открыть Vibe"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím otvoríte Vibe"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka för att öppna Vibe"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกเพื่อเปิด Vibe"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe’ı açmak için tıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб відкрити Vibe"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm để mở Vibe"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以打开 Vibe"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下以打開 Vibe"
          }
        }
      },
      "extractionState": "manual"
    },
    "widget.empty.tap": {
