{
  "sourceLanguage": "en",
  "strings": {
    "widget.description": {
      "comment": "iOS widget gallery: the one-line description under every Vibe widget's name, shown while the user is choosing a widget to add. Vibe is the app name.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво възпроизвежда Vibe в момента."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co Vibe právě přehrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad Vibe afspiller lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Vibe gerade abspielt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι αναπαράγει τώρα το Vibe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Vibe is currently playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que Vibe está reproduciendo ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä Vibe toistaa juuri nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Vibe lit en ce moment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što Vibe trenutačno reproducira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit a Vibe éppen lejátszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang sedang diputar Vibe saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa sta riproducendo Vibe in questo momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibeで現在再生中の曲。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe에서 현재 재생 중인 항목."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva Vibe spiller akkurat nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat Vibe nu afspeelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co Vibe teraz odtwarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Vibe está reproduzindo agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Vibe está a reproduzir neste momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce redă Vibe în acest moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что сейчас воспроизводит Vibe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo Vibe práve prehráva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad Vibe spelar just nu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ Vibe กำลังเล่นอยู่ตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe’ın şu anda çaldığı parça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що зараз відтворює Vibe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe đang phát gì lúc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe 当前正在播放的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe 目前正在播放的內容。"
          }
        }
      },
      "extractionState": "manual"
    },
