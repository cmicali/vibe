    "widget.intent.play_pause": {
      "comment": "Name of the widget's play/pause action, as it appears in the Shortcuts app's action list. A command, not a label.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусни/Пауза"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrát/Pozastavit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil/Pause"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abspielen/Pause"
          }
        },
