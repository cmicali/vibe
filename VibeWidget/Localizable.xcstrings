    "widget.name.now_playing": {
      "comment": "iOS widget gallery: the name every Vibe widget shares, Home Screen and Lock Screen alike. Each shows the track that is playing. Use the system's term for the track that is playing now.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сега се възпроизвежда"
