# General
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride

# Xcode

xcuserdata/
*.xcscmblueprint
*.xccheckout
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
/*.gcno

# AppCode
.idea/

# XcodeGen — the Xcode project is generated from project.yml; do not track it.
/Vibe.xcodeproj/
Vibe/App/Info.plist
Vibe/iOS/Info.plist

# Generated test audio (.claude/skills/vibe-debug/scripts/generate-test-audio.sh)
/Assets/test_audio_files/

# Byte-compiled Python, which appears under the skills' scripts/ whenever one
# of them is imported rather than run.
__pycache__/
*.pyc

# Localized App Store screenshots are regenerated, not tracked; the English
# set stays tracked. Assets/app-store/copy/ is the source of truth and tracked.
/Assets/app-store/screenshots/*/
!/Assets/app-store/screenshots/en/

# Swift build products of the App Store metadata uploader.
/scripts/asc-upload/.build/

# App Store Connect API key id / issuer id for scripts/release-appstore.sh.
/.release-env

# App Store Connect API keys must never be committed, wherever they're dropped.
*.p8




.claude/worktrees/
