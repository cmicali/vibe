# General
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride

# Xcode

xcuserdata/
*.xcscmblueprint
*.xccheckout
build/
# The build scripts, not build output.
!/scripts/build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
/*.gcno

# IDE state
.idea/
# clang's compilation database. `make compile-commands` writes it.
/compile_commands.json

# XcodeGen — the Xcode project is generated from project.yml; do not track it.
/Vibe.xcodeproj/
# perf.py derives the component benchmarks' project from the Vibe target.
/VibeBenchComponents.xcodeproj/
Vibe/Mac/App/Info.plist
Vibe/iOS/Info.plist
VibeWidget/Info.plist

# Claude Code worktrees are checkouts of this repo living inside it; the rest
# of .claude/ (skills, commands) stays tracked.
/.claude/worktrees/

# Generated test audio (scripts/test/generate-test-audio.sh)
/Assets/test_audio_files/

# Python bytecode.
__pycache__/
*.pyc

# Swift helpers the skills' scripts compile on demand beside their source. The
# .swift stays tracked; the binary is build output and is arch-specific.
/.claude/skills/*/scripts/*-helper

# Localized App Store screenshots are regenerated, not tracked; the English
# set stays tracked. Assets/app-store/copy/ is the source of truth and tracked.
/Assets/app-store/screenshots/*/
!/Assets/app-store/screenshots/en/

# Swift build products of the App Store metadata uploader.
/scripts/appstore/asc-upload/.build/

# App Store Connect API key id / issuer id for scripts/appstore/release-appstore.sh.
/.release-env

# App Store Connect API keys must never be committed, wherever they're dropped.
*.p8

# Local Wrangler state.
/.wrangler/

# Claude
.claude/worktrees/

/debug/

# Local retagged copies of the screenshot author's music; never publish recordings.
/Assets/app-store/demo-music/tracks/
