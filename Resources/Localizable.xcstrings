    "label.convert.save_message": {
      "comment": "Message atop the save panel that appears when the app may not write next to the source file.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете къде да запазите конвертирания FLAC файл."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvor den konverterede FLAC-fil skal arkiveres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wo die konvertierte FLAC-Datei gesichert werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to save the converted FLAC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde guardar el FLAC convertido."
          }
