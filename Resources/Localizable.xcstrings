    "settings.general.bit_perfect.balance": {
      "comment": "Bit-perfect output is scaling one channel because the system balance is not centered",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Системният баланс не е центриран; центрирайте го за битово точен изход"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémové vyvážení není uprostřed; pro bitově přesný výstup je nastavte na střed"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systembalancen er ikke centreret; centrer den for bitperfekt output"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systembalance ist nicht mittig; stelle sie für bitgenaue Ausgabe auf die Mitte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ισορροπία του συστήματος δεν είναι στο κέντρο· κεντράρετέ την για έξοδο bit-perfect"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System balance not centered: center it for bit-perfect output"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El balance del sistema no está centrado; céntralo para una salida bit-perfect"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmän balanssi ei ole keskellä; keskitä se bittitarkkaa lähtöä varten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La balance du système n’est pas centrée ; centrez-la pour une sortie bit-perfect"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravnoteža sustava nije centrirana; centrirajte je za bitovno točan izlaz"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer balansza nincs középen; a bitpontos kimenethez állítsd középre"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keseimbangan sistem tidak di tengah; atur ke tengah untuk output bit-perfect"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bilanciamento del sistema non è centrato; centralo per un’uscita bit-perfect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのバランスが中央になっていません。ビットパーフェクト出力には中央に設定してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 밸런스가 중앙이 아닙니다. 비트 퍼펙트 출력을 위해 중앙으로 설정하십시오"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systembalansen er ikke sentrert; sentrer den for bitperfekt utgang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De systeembalans staat niet in het midden; centreer deze voor bitperfecte uitvoer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Balans systemu nie jest wyśrodkowany; wyśrodkuj go, aby uzyskać wyjście bit-perfect"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O balanço do sistema não está centralizado; centralize-o para uma saída bit-perfect"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O balanço do sistema não está centrado; centre-o para uma saída bit-perfect"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Balansul sistemului nu este centrat; centrați-l pentru ieșire bit-perfect"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс системы не по центру; установите его по центру для побитово точного вывода"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyváženie systému nie je v strede; pre bitovo presný výstup ho nastavte na stred"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systembalansen är inte centrerad; centrera den för bitperfekt utmatning"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมดุลเสียงของระบบไม่ได้อยู่ตรงกลาง ให้ปรับไว้ตรงกลางเพื่อใช้เอาต์พุตแบบบิตเพอร์เฟกต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem dengesi ortalanmamış; bit düzeyinde kusursuz çıkış için ortalayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс системи не по центру; установіть його по центру для побітово точного виведення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cân bằng của hệ thống chưa ở giữa; hãy đặt về giữa để có đầu ra bit-perfect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统平衡未居中，请将其居中以实现比特完美输出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統平衡未置中，請將其置中以實現位元完美輸出"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.general.bit_perfect.caption_off": {
      "comment": "Settings, Audio pane: caption under the bit-perfect output switch while it is off, explaining what turning it on does. No trailing period.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройва устройството според честотата на дискретизация и битовата дълбочина на всеки файл"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví zařízení na vzorkovací frekvenci a bitovou hloubku každého souboru"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstiller enheden til hver fils samplingsfrekvens og bitdybde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Gerät auf die Abtastrate und Bittiefe jeder Datei ein"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίζει τη συσκευή στον ρυθμό δειγματοληψίας και το βάθος bit κάθε αρχείου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the device to each file's sample rate and bit depth"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el dispositivo a la frecuencia de muestreo y la profundidad de bits de cada archivo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa laitteen kunkin tiedoston näytteenottotaajuudelle ja bittisyvyydelle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle l’appareil sur la fréquence d’échantillonnage et la profondeur de bits de chaque fichier"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavlja uređaj na frekvenciju uzorkovanja i dubinu bita svake datoteke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközt az egyes fájlok mintavételi frekvenciájára és bitmélységére állítja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur perangkat ke laju sampel dan kedalaman bit setiap file"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il dispositivo sulla frequenza di campionamento e la profondità di bit di ogni file"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ファイルのサンプルレートとビット深度に合わせてデバイスを設定します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 파일의 샘플률과 비트 심도에 맞춰 기기를 설정합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter enheten til samplingsfrekvensen og bitdybden til hver fil"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt het apparaat in op de samplefrequentie en bitdiepte van elk bestand"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia urządzenie na częstotliwość próbkowania i głębię bitową każdego pliku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o dispositivo à taxa de amostragem e à profundidade de bits de cada arquivo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o dispositivo à frequência de amostragem e à profundidade de bits de cada ficheiro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurează dispozitivul la rata de eșantionare și adâncimea de biți ale fiecărui fișier"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает для устройства частоту дискретизации и битовую глубину каждого файла"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví zariadenie na vzorkovaciu frekvenciu a bitovú hĺbku každého súboru"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställer in enheten på varje fils samplingsfrekvens och bitdjup"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าอุปกรณ์ให้ตรงกับอัตราสุ่มตัวอย่างและความลึกบิตของแต่ละไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtı her dosyanın örnekleme hızına ve bit derinliğine ayarlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлює для пристрою частоту дискретизації та бітову глибину кожного файлу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt thiết bị theo tần số lấy mẫu và độ sâu bit của từng tệp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将设备设为每个文件的采样率和位深度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將裝置設為每個檔案的取樣率和位元深度"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.general.bit_perfect.channels": {
      "comment": "Bit-perfect output status: the decoded file, mixer or output device has a different channel count, so unchanged delivery of every channel is not verified.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пътят на възпроизвеждане променя броя канали на този файл"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesta přehrávání mění počet kanálů tohoto souboru"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilningskæden ændrer antallet af kanaler i denne fil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wiedergabepfad verändert die Kanalanzahl dieser Datei"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαδρομή αναπαραγωγής αλλάζει τον αριθμό καναλιών αυτού του αρχείου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The playback path changes this file's channel count"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta de reproducción cambia el número de canales de este archivo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistopolku muuttaa tämän tiedoston kanavien määrää"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin de lecture modifie le nombre de canaux de ce fichier"
