    "settings.about": {
      "comment": "Settings window: the About pane's sidebar item, and the window's title while that pane is selected; also the About row and screen title on iOS. It shows the app icon, version, project links and lifetime statistics. Use the word Apple uses for an app's About screen in this language.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Относно"
          }
        },
        "cs": {
