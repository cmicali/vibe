    "settings.general.bit_perfect.needs_device": {
      "comment": "Settings, Audio pane: caption under the disabled bit-perfect output switch while the chosen device is Bluetooth, AirPlay or another transport the mode cannot drive. The System Output row has its own caption below. No trailing period.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете кабелно устройство"
          }
        },
        "cs": {
