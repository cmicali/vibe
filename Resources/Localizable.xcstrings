    "label.drop_hint": {
      "comment": "Empty-state hint shown when no track is loaded. %@ is the Open shortcut, rendered as key glyphs (⌘O) — keep it as a placeholder, don't spell it out.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a file or press %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei ablegen oder %@ drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta un archivo o pulsa %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un fichier ou appuyez sur %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un file o premi %@"
          }
        }
      }
    },
    "label.pitch": {
      "comment": "Label above the pitch fader. Upper-case, like the printed legend on a DJ turntable. Very tight space — about 8 characters.",
