    "settings.general.exclusive_output.caption": {
      "comment": "Settings: exclusive output explanation. No trailing period.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не позволява на други приложения да използват изходното устройство по време на възпроизвеждане"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během přehrávání zabrání ostatním aplikacím používat výstupní zařízení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhindrer andre apps i at bruge outputenheden under afspilning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass andere Apps das Ausgabegerät während der Wiedergabe verwenden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμποδίζει άλλες εφαρμογές να χρησιμοποιούν τη συσκευή εξόδου κατά την αναπαραγωγή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops other apps from using the output device while playing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que otras apps usen el dispositivo de salida durante la reproducción"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estää muita appeja käyttämästä lähtölaitetta toiston aikana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche les autres apps d’utiliser l’appareil de sortie pendant la lecture"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprječava druge aplikacije da koriste izlazni uređaj tijekom reprodukcije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejátszás közben megakadályozza, hogy más appok használják a kimeneti eszközt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencegah app lain menggunakan perangkat output selama pemutaran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce alle altre app di usare il dispositivo di uscita durante la riproduzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中にほかのアプリが出力デバイスを使用することを防ぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중에 다른 앱이 출력 기기를 사용하지 못하게 합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrer andre apper i å bruke utgangsenheten under avspilling"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt dat andere apps het uitvoerapparaat gebruiken tijdens het afspelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniemożliwia innym aplikacjom korzystanie z urządzenia wyjściowego podczas odtwarzania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que outros apps usem o dispositivo de saída durante a reprodução"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que outras aplicações usem o dispositivo de saída durante a reprodução"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împiedică alte aplicații să folosească dispozitivul de ieșire în timpul redării"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не позволяет другим приложениям использовать устройство вывода во время воспроизведения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas prehrávania zabráni ostatným apkám používať výstupné zariadenie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrar andra appar från att använda utmatningsenheten under uppspelning"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้องกันไม่ให้แอปอื่นใช้อุปกรณ์เอาต์พุตระหว่างการเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma sırasında diğer uygulamaların çıkış aygıtını kullanmasını engeller"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дозволяє іншим програмам використовувати пристрій виведення під час відтворення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn các ứng dụng khác sử dụng thiết bị đầu ra trong khi phát"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放时阻止其他 App 使用输出设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放時防止其他 App 使用輸出裝置"
          }
        }
      },
      "extractionState": "manual"
    },
