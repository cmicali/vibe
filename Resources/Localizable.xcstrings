    "label.library.empty.message": {
      "comment": "iOS: explanatory line under the empty library headline, above the Open button.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете папка или файл, за да започнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte výběrem složky nebo souboru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe eller en fil for at komme i gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner oder eine Datei, um loszulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε έναν φάκελο ή ένα αρχείο για να ξεκινήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder or file to get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta o un archivo para empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita valitsemalla kansio tai tiedosto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier ou un fichier pour commencer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite mapu ili datoteku za početak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdésként válassz egy mappát vagy fájlt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder atau file untuk memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella o un file per iniziare."
          }
        },
        "ja": {
