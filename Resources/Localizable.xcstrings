            "value": "添加文件夹…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入檔案夾…"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.permissions.explain": {
      "comment": "Settings, Files pane: explanatory text above the list of granted folders. %@ is the app name.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ може да чете музика в тези папки. Добавете често използваните, за да избегнете повтарящи се заявки за разрешение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ umí číst hudbu v těchto složkách. Přidejte ty, které používáte často, abyste se vyhnuli opakovaným žádostem o oprávnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan læse musik i disse mapper. Tilføj dem, du bruger ofte, så du undgår gentagne anmodninger om tilladelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann Musik in diesen Ordnern lesen. Füge die Ordner hinzu, die du oft verwendest, um wiederholte Berechtigungsanfragen zu vermeiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ μπορεί να διαβάζει μουσική σε αυτούς τους φακέλους. Προσθέστε όσους χρησιμοποιείτε συχνά, για να αποφύγετε τα επαναλαμβανόμενα αιτήματα άδειας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can read music in these folders. Add the ones you use often to avoid repeated permission prompts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puede leer música en estas carpetas. Añade las que uses a menudo para evitar solicitudes de permiso repetidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voi lukea musiikkia näistä kansioista. Lisää usein käyttämäsi kansiot, niin vältät toistuvat käyttöoikeuspyynnöt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut lire la musique dans ces dossiers. Ajoutez ceux que vous utilisez souvent pour éviter les demandes d’autorisation répétées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ može čitati glazbu u ovim mapama. Dodajte one koje često koristite kako biste izbjegli ponavljajuće zahtjeve za dozvolu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ olvasni tudja a zenét ezekben a mappákban. Add hozzá azokat, amelyeket gyakran használsz, így elkerülöd az ismétlődő engedélykéréseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dapat membaca musik di folder-folder ini. Tambahkan folder yang sering Anda gunakan untuk menghindari permintaan izin berulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ può leggere la musica in queste cartelle. Aggiungi quelle che usi spesso per evitare richieste di autorizzazione ripetute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこれらのフォルダ内の音楽を読み込めます。よく使うフォルダを追加すると、繰り返しアクセス許可を求められずに済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 이 폴더에 있는 음악을 읽을 수 있습니다. 자주 사용하는 폴더를 추가하면 권한 요청이 반복되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan lese musikk i disse mappene. Legg til dem du bruker ofte, så slipper du gjentatte tillatelsesforespørsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan muziek in deze mappen lezen. Voeg de mappen toe die je vaak gebruikt, zo voorkom je herhaalde toestemmingsvragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ może odczytywać muzykę w tych folderach. Dodaj te, z których korzystasz często, aby uniknąć powtarzających się próśb o uprawnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ pode ler músicas nestas pastas. Adicione as que você usa com frequência para evitar pedidos de permissão repetidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ pode ler música nestas pastas. Adicione as que utiliza com frequência para evitar pedidos de permissão repetidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poate citi muzica din aceste dosare. Adăugați-le pe cele pe care le folosiți des, pentru a evita solicitările repetate de permisiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ может читать музыку в этих папках. Добавьте те, которыми вы часто пользуетесь, чтобы не отвечать на повторяющиеся запросы разрешений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dokáže čítať hudbu v týchto priečinkoch. Pridajte tie, ktoré používate často, aby ste sa vyhli opakovaným žiadostiam o povolenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan läsa musik i dessa mappar. Lägg till de mappar du använder ofta så slipper du upprepade behörighetsfrågor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ อ่านเพลงในโฟลเดอร์เหล่านี้ได้ เพิ่มโฟลเดอร์ที่คุณใช้บ่อยเพื่อไม่ให้ระบบขอสิทธิ์ซ้ำ ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu klasörlerdeki müzikleri okuyabilir. Sık kullandıklarınızı ekleyerek tekrarlanan izin isteklerinden kurtulun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ може читати музику в цих папках. Додайте ті, якими ви часто користуєтеся, щоб уникнути повторних запитів на дозвіл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ có thể đọc nhạc trong các thư mục này. Hãy thêm những thư mục bạn hay dùng để tránh phải cấp quyền nhiều lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可以读取这些文件夹中的音乐。添加常用的文件夹，即可避免反复出现权限请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可以讀取這些檔案夾中的音樂。加入常用的檔案夾，即可避免重複出現權限請求。"
          }
        }
      },
      "extractionState": "manual"
    },
