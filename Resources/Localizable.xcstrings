    "settings.appearance.waveform_levels_caption": {
      "comment": "macOS Settings: Applies to all themes. Changes the waveform display only. Playback volume is unchanged.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прилага се за всички теми. Променя само изгледа на вълновата форма. Силата на звука не се променя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro všechny motivy. Mění pouze zobrazení průběhu vlny. Hlasitost přehrávání se nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gælder alle temaer. Ændrer kun bølgeformens visning. Afspilningslydstyrken ændres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alle Themen. Ändert nur die Wellenformdarstellung. Die Wiedergabelautstärke bleibt unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει για όλα τα θέματα. Αλλάζει μόνο την εμφάνιση της κυματομορφής. Η ένταση αναπαραγωγής δεν αλλάζει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to all themes. Changes the waveform display only. Playback volume is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todos los temas. Solo cambia la forma de onda mostrada. El volumen de reproducción no cambia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koskee kaikkia teemoja. Muuttaa vain aaltomuodon näkymää. Toiston äänenvoimakkuus ei muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à tous les thèmes. Modifie uniquement l’affichage de la forme d’onde. Le volume de lecture reste inchangé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjenjuje se na sve teme. Mijenja samo prikaz valnog oblika. Glasnoća reprodukcije ostaje ista."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden témára érvényes. Csak a hullámforma megjelenítését módosítja. A lejátszás hangereje nem változik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku untuk semua tema. Hanya mengubah tampilan bentuk gelombang. Volume pemutaran tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a tutti i temi. Modifica solo la forma d’onda visualizzata. Il volume di riproduzione rimane invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのテーマに適用されます。波形の表示のみを変更します。再生音量は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 테마에 적용됩니다. 파형 표시만 변경합니다. 재생 음량은 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjelder alle temaer. Endrer bare bølgeformvisningen. Avspillingsvolumet endres ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor alle thema’s. Wijzigt alleen de golfvormweergave. Het afspeelvolume blijft gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy wszystkich motywów. Zmienia tylko wyświetlanie przebiegu fali. Głośność odtwarzania pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado a todos os temas. Altera apenas a exibição da forma de onda. O volume de reprodução não muda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todos os temas. Altera apenas a apresentação da forma de onda. O volume de reprodução não muda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică tuturor temelor. Modifică doar afișarea formei de undă. Volumul redării rămâne neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется ко всем темам. Меняет только отображение формы волны. Громкость воспроизведения не меняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pre všetky motívy. Mení len zobrazenie priebehu vlny. Hlasitosť prehrávania sa nemení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäller alla teman. Ändrar bara vågformsvisningen. Uppspelningsvolymen ändras inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับทุกธีม เปลี่ยนเฉพาะการแสดงรูปคลื่น ระดับเสียงการเล่นไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm temalar için geçerlidir. Yalnızca dalga biçimi görünümünü değiştirir. Çalma ses düzeyi değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується до всіх тем. Змінює лише відображення форми хвилі. Гучність відтворення не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho tất cả chủ đề. Chỉ thay đổi cách hiển thị dạng sóng. Âm lượng phát lại không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有主题。仅更改波形显示，不改变播放音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於所有主題。僅更改波形顯示，不改變播放音量。"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.appearance.waveform_levels_unavailable": {
      "comment": "macOS Settings: caption when the selected waveform style does not support waveform height controls. %@ is the localized waveform style name.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не поддържа настройка на височината на вълновата форма"
