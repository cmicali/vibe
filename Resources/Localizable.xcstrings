          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di riproduzione"
          }
        }
      }
    },
    "label.about.version": {
      "comment": "About window: %@ is the version number, e.g. '1.5 (15) · Release'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
