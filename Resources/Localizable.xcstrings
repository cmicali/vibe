    "settings.advanced.audio_path.resampled": {
      "comment": "Settings, Advanced pane, Audio group: decoder readout when the file's sample rate is converted, e.g. 'Resampled 44.1 kHz → 48 kHz at maximum quality'. %1$@ and %2$@ are already-formatted sample rates; keep the arrow between them.",
