    "settings.search_folders.covered": {
      "comment": "iOS settings screen: alert message shown when the user adds a folder that sits inside a folder already on the list. Permission to a folder covers everything inside it, so nothing needed to be added.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази папка вече е в папка, която сте добавили, така че вече се търси в нея."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato složka už je uvnitř složky, kterou jste přidali, takže se v ní už hledá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mappe ligger allerede i en, du har tilføjet, så der søges allerede i den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner liegt bereits in einem hinzugefügten Ordner und wird deshalb schon durchsucht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος βρίσκεται ήδη μέσα σε έναν που προσθέσατε, οπότε ήδη περιλαμβάνεται στην αναζήτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder is already inside one you added, so it is being searched already."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa carpeta ya está dentro de una que añadiste, así que ya se está buscando en ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansio on jo lisäämäsi kansion sisällä, joten siitä etsitään jo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier se trouve déjà dans un dossier que vous avez ajouté ; il est donc déjà inclus dans la recherche."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta se mapa već nalazi u mapi koju ste dodali, pa se već pretražuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mappa már benne van egy hozzáadott mappában, így a keresés már kiterjed rá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder itu sudah berada di dalam folder yang Anda tambahkan, jadi sudah ikut dicari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella cartella è già dentro una che hai aggiunto, quindi viene già cercata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダは追加済みのフォルダの中にあるため、すでに検索対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 폴더는 이미 추가한 폴더 안에 있으므로 이미 검색되고 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mappen ligger allerede i en du har lagt til, så den blir allerede søkt i."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die map staat al in een map die je hebt toegevoegd en wordt dus al doorzocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder znajduje się już w folderze, który dodano, więc jest już przeszukiwany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pasta já está dentro de uma que você adicionou, então ela já está sendo pesquisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pasta já está dentro de uma que adicionou, pelo que já está a ser pesquisada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acel dosar se află deja într-un dosar adăugat, deci este deja inclus în căutare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка уже находится внутри добавленной, поэтому поиск в ней уже выполняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento priečinok už je vnútri priečinka, ktorý ste pridali, takže sa v ňom už hľadá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mappen ligger redan i en mapp du har lagt till, så den söks redan igenom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นั้นอยู่ในโฟลเดอร์ที่คุณเพิ่มไว้แล้ว จึงถูกค้นหาอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör zaten eklediğiniz bir klasörün içinde, dolayısıyla zaten aranıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка вже міститься в доданій, тому пошук у ній уже виконується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục đó đã nằm trong một thư mục bạn đã thêm, nên nó đã được tìm kiếm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件夹已位于你添加的文件夹中，因此已在搜索范围内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案夾已位於你加入的檔案夾中，因此已在搜尋範圍內。"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.search_folders.footer": {
      "comment": "iOS settings screen: explanation under the list of searchable folders. %@ is the app name. Says what search already covers, that subfolders are included, and why adding a folder is necessary — iOS gives an app no access to files the user has not handed it.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Търсенето обхваща отворената папка и всичко, което добавите тук, включително подпапките. Без папка %@ не може да търси във вашите файлове."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání prochází otevřenou složku a vše, co sem přidáte, včetně podsložek. Bez složky nemůže %@ vaše soubory prohledávat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgningen gennemgår den åbne mappe og alt, du tilføjer her, inklusive undermapper. %@ kan ikke søge i dine filer uden først at få en mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche durchsucht den geöffneten Ordner und alles, was du hier hinzufügst, einschließlich Unterordnern. Ohne einen Ordner kann %@ deine Dateien nicht durchsuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση εξετάζει τον ανοιχτό φάκελο και ό,τι προσθέσετε εδώ, μαζί με τους υποφακέλους. Χωρίς φάκελο, το %@ δεν μπορεί να αναζητήσει στα αρχεία σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search looks through the folder you have open and anything you add here, including subfolders. %@ cannot search your files without being given a folder first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda recorre la carpeta que tienes abierta y todo lo que añadas aquí, incluidas las subcarpetas. %@ no puede buscar en tus archivos sin que antes le des una carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haku käy läpi avoinna olevan kansion ja kaiken tähän lisäämäsi, alikansiot mukaan lukien. %@ ei voi etsiä tiedostoistasi ilman kansiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche parcourt le dossier ouvert et tout ce que vous ajoutez ici, sous-dossiers compris. Sans dossier, %@ ne peut pas rechercher dans vos fichiers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretraživanje obuhvaća otvorenu mapu i sve što ovdje dodate, uključujući podmape. Bez mape %@ ne može pretraživati vaše datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keresés az éppen megnyitott mappát és mindent átnéz, amit itt hozzáadsz, az almappákkal együtt. Mappa nélkül a %@ nem tud a fájljaid között keresni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian menelusuri folder yang sedang dibuka dan semua yang Anda tambahkan di sini, termasuk subfolder. %@ tidak dapat mencari file Anda tanpa diberi folder terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca esamina la cartella aperta e tutto ciò che aggiungi qui, sottocartelle comprese. Senza una cartella, %@ non può cercare nei tuoi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索は、開いているフォルダとここに追加したもの（サブフォルダを含む）を対象にします。フォルダが与えられていないと、%@はファイルを検索できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 열려 있는 폴더와 여기에 추가한 모든 항목(하위 폴더 포함)을 살펴봅니다. 폴더를 먼저 지정하지 않으면 %@는 파일을 검색할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søket går gjennom den åpne mappen og alt du legger til her, inkludert undermapper. %@ kan ikke søke i filene dine uten først å få en mappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken doorzoekt de geopende map en alles wat je hier toevoegt, inclusief submappen. Zonder een map kan %@ niet in je bestanden zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie obejmuje otwarty folder i wszystko, co tu dodasz, łącznie z podfolderami. Bez wskazanego folderu %@ nie może przeszukiwać plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca percorre a pasta aberta e tudo o que você adicionar aqui, incluindo subpastas. O %@ não pode buscar nos seus arquivos sem antes receber uma pasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa percorre a pasta aberta e tudo o que adicionar aqui, incluindo subpastas. O %@ não pode pesquisar nos seus ficheiros sem primeiro receber uma pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutarea parcurge dosarul deschis și tot ce adăugați aici, inclusiv subdosarele. Fără un dosar, %@ nu poate căuta în fișierele dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск охватывает открытую папку и все, что вы добавите здесь, включая вложенные папки. Без папки %@ не может искать в ваших файлах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhľadávanie prechádza otvorený priečinok a všetko, čo sem pridáte, vrátane podpriečinkov. Bez priečinka nemôže %@ vaše súbory prehľadávať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökningen går igenom den öppna mappen och allt du lägger till här, inklusive undermappar. %@ kan inte söka i dina filer utan att först få en mapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาจะครอบคลุมโฟลเดอร์ที่เปิดอยู่และทุกสิ่งที่คุณเพิ่มที่นี่ รวมถึงโฟลเดอร์ย่อย %@ ไม่สามารถค้นหาไฟล์ของคุณได้หากยังไม่ได้รับโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama, açık olan klasörü ve buraya eklediğiniz her şeyi, alt klasörler dahil, tarar. Önce bir klasör verilmeden %@ dosyalarınızda arama yapamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук охоплює відкриту папку та все, що ви додасте тут, включно з вкладеними папками. Без папки %@ не може шукати у ваших файлах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm sẽ quét thư mục bạn đang mở và mọi thứ bạn thêm ở đây, bao gồm cả thư mục con. %@ không thể tìm trong tệp của bạn nếu chưa được cấp một thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索会查找你打开的文件夹以及在此添加的所有内容，包括子文件夹。未提供文件夹时，%@ 无法搜索你的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋會查找你開啟的檔案夾以及在此加入的所有內容，包括子檔案夾。未提供檔案夾時，%@ 無法搜尋你的檔案。"
          }
        }
      },
      "extractionState": "manual"
    },
