    "settings.appearance.waveform_gain_caption": {
      "comment": "Settings, Appearance pane, Waveform group: caption under the Gain row, explaining the slider's second effect — turned down, a heavily limited track stops drawing as a flat block and its variation becomes visible.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намалете го, за да видите повече от динамичния обхват на силен запис."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snižte ho, aby byl u hlasité skladby vidět větší dynamický rozsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skru ned for at se mere af et højt nummers dynamiske område."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger einstellen, um bei lauten Titeln mehr vom Dynamikumfang zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαμηλώστε το για να δείτε περισσότερο από το δυναμικό εύρος ενός δυνατού κομματιού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower it to see more of a loud track's dynamic range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bájala para ver más del rango dinámico de una pista con mucho volumen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske sitä nähdäksesi enemmän äänekkään kappaleen dynamiikkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baissez-le pour voir davantage la dynamique d'un morceau très fort."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smanjite ga da biste vidjeli više dinamičkog raspona glasne pjesme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedd lejjebb, hogy a hangos számok dinamikatartományából többet láss."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Turunkan untuk melihat lebih banyak rentang dinamis lagu yang keras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassalo per vedere meglio la gamma dinamica di un brano ad alto volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下げると、音量の大きい曲のダイナミックレンジがより見やすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮추면 음량이 큰 트랙의 다이내믹 레인지를 더 잘 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skru ned for å se mer av det dynamiske området i et høyt spor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet hem lager om meer van het dynamisch bereik van een luid nummer te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz, aby zobaczyć więcej zakresu dynamiki głośnego utworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminua para ver mais da faixa dinâmica de uma música alta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe para ver mais da gama dinâmica de uma faixa com muito volume."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduceți-l pentru a vedea mai mult din gama dinamică a unei piese puternice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшите, чтобы увидеть больше динамического диапазона громкого трека."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znížte ho, aby bol pri hlasnej skladbe vidieť väčší dynamický rozsah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sänk för att se mer av ett högljutt spårs dynamiska omfång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดลงเพื่อดูช่วงไดนามิกของเพลงที่ดังได้มากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek sesli bir parçanın dinamik aralığını daha iyi görmek için azaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменште, щоб побачити більше динамічного діапазону гучного треку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm xuống để thấy rõ hơn dải động của bài hát lớn tiếng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调低可看到响度较大曲目更多的动态范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調低可看到響度較大曲目更多的動態範圍。"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.appearance.waveform_gain_value": {
      "comment": "Settings, Appearance pane: the waveform gain slider's live readout, e.g. '+3 dB' or '−6 dB'. %@ is the already-formatted signed number. Keep the 'dB' unit, in the locale's own spelling if it has one.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дБ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dB"
          }
