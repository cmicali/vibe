    "settings.advanced.reset_caption": {
      "comment": "Settings, Advanced pane: hint below Reset; custom themes and their images are kept.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връща всички настройки по подразбиране. Запазва персонализираните теми."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví výchozí hodnoty všech nastavení. Vlastní motivy zůstanou zachovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulstiller alle indstillinger til standardværdierne. Beholder tilpassede temaer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt alle Einstellungen auf die Standardwerte zurück. Eigene Designs bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει όλες τις ρυθμίσεις στις προεπιλογές. Διατηρεί τα προσαρμοσμένα θέματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset all settings to defaults, keeps custom themes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece todos los ajustes predeterminados. Conserva los temas personalizados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa kaikki asetukset oletusarvoihin. Säilyttää omat teemat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit tous les réglages par défaut. Conserve les thèmes personnalisés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća sve postavke na zadane vrijednosti. Zadržava prilagođene teme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes beállítás visszaállítása az alapértékekre. Az egyéni témák megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur ulang semua pengaturan ke default. Tema khusus tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina tutte le impostazioni predefinite. Mantiene i temi personalizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定をデフォルトに戻します。カスタムテーマは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정을 기본값으로 재설정합니다. 사용자 설정 테마는 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakestiller alle innstillinger til standardverdiene. Beholder egendefinerte temaer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt alle standaardinstellingen. Aangepaste thema’s blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca domyślne wartości wszystkich ustawień. Zachowuje własne motywy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefine todos os ajustes para os padrões. Mantém os temas personalizados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe todas as predefinições. Mantém os temas personalizados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește toate configurările implicite. Păstrează temele personalizate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает настройки по умолчанию. Сохраняет пользовательские темы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví predvolené hodnoty všetkých nastavení. Zachová vlastné témy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer alla inställningar till standardvärdena. Behåller anpassade teman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตการตั้งค่าทั้งหมดเป็นค่าเริ่มต้น โดยเก็บธีมที่กำหนดเองไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm ayarları saptanmış değerlere döndürür. Özel temaları korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює типові значення всіх параметрів. Зберігає власні теми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại tất cả cài đặt về mặc định. Giữ lại các chủ đề tùy chỉnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有设置恢复为默认值。保留自定义主题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有設定恢復為預設值。保留自訂主題。"
          }
        }
      },
      "extractionState": "manual"
    },
