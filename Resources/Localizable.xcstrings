        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filens bitdybde er større enn enheten kan spille av"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bitdiepte van het bestand is hoger dan het apparaat kan afspelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głębia bitowa pliku przekracza możliwości odtwarzania urządzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A profundidade de bits do arquivo excede a capacidade de reprodução do dispositivo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A profundidade de bits do ficheiro excede a capacidade de reprodução do dispositivo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adâncimea de biți a fișierului depășește capacitatea de redare a dispozitivului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
