    "settings.general.reopen_playlist.caption": {
      "comment": "Settings, General pane: caption under the 'Reopen last playlist' switch. One sentence, no trailing period, saying when the playlist is saved and when it comes back.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плейлистът се запазва при изход и се зарежда при следващото стартиране"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist se uloží při ukončení a načte při příštím spuštění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelisten gemmes ved afslutning og indlæses ved næste start"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabeliste wird beim Beenden gesichert und beim nächsten Start geladen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα αναπαραγωγής αποθηκεύεται κατά την έξοδο και φορτώνεται στην επόμενη εκκίνηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist is saved on quit and loaded on next launch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de reproducción se guarda al salir y se carga en el siguiente inicio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittolista tallennetaan lopetettaessa ja ladataan seuraavalla käynnistyskerralla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste de lecture est enregistrée à la fermeture et chargée au prochain démarrage"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popis pjesama sprema se pri izlasku i učitava pri sljedećem pokretanju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lejátszási lista kilépéskor mentődik, és a következő indításkor betöltődik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist disimpan saat keluar dan dimuat pada saat mulai berikutnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La playlist viene salvata all'uscita e caricata all'avvio successivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時にプレイリストを保存し、次回起動時に読み込みます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시 재생목록을 저장하고 다음 시작 시 불러옵니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelisten arkiveres ved avslutning og lastes inn ved neste oppstart"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afspeellijst wordt bewaard bij het stoppen en geladen bij de volgende start"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlista jest zachowywana przy zakończeniu i wczytywana przy następnym uruchomieniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A playlist é salva ao sair e carregada na próxima inicialização"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de reprodução é guardada ao sair e carregada no próximo arranque"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlistul este salvat la ieșire și încărcat la următoarea pornire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плейлист сохраняется при выходе и загружается при следующем запуске"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist sa uloží pri ukončení a načíta pri ďalšom spustení"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spellistan sparas när du avslutar och läses in vid nästa start"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลย์ลิสต์จะถูกบันทึกเมื่อออกและโหลดในการเริ่มต้นครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma listesi çıkışta kaydedilir ve bir sonraki başlangıçta yüklenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плейлист зберігається під час виходу й завантажується під час наступного запуску"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách phát được lưu khi thoát và tải ở lần khởi động tiếp theo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出时保存播放列表，下次启动时加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束時儲存播放列表，下次啟動時載入"
          }
        }
