{
  "sourceLanguage": "en",
  "strings": {
    "a11y.playlist.open": {
      "comment": "Accessibility label for the empty playlist pane's drop well, which opens the file picker when pressed.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори песни или папки"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn sange eller mapper"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel oder Ordner öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open songs or folders"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir canciones o carpetas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kappaleita tai kansioita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir des fichiers ou des dossiers"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori pjesme ili mape"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri brani o cartelle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲またはフォルダを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래 또는 폴더 열기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne sanger eller mapper"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open nummers of mappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz utwory lub teczki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir músicas ou pastas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir músicas ou pastas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți melodii sau dosare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть песни или папки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna låtar eller mappar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıları veya klasörleri aç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити пісні чи папки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开歌曲或文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開歌曲或資料夾"
          }
        }
      },
      "extractionState": "manual"
    },
    "a11y.playlist.toggle": {
      "comment": "Accessibility label for the button that shows and hides the playlist.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
