    "settings.appearance.waveform_normalize_caption": {
      "comment": "Settings, Appearance pane, Waveform group: caption under the Normalize switch, saying what it does.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw every track with its loudest passage at full height."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки запис се изчертава с най-силния си пасаж на пълна височина."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá skladba se vykreslí tak, aby její nejhlasitější část dosahovala plné výšky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner hvert nummer med den højeste passage i fuld højde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet jeden Titel so, dass seine lauteste Stelle die volle Höhe erreicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάζει κάθε κομμάτι με το πιο δυνατό του σημείο σε πλήρες ύψος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja cada pista con su pasaje más alto a toda la altura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirtää jokaisen kappaleen niin, että sen äänekkäin kohta yltää täyteen korkeuteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessine chaque morceau avec son passage le plus fort à pleine hauteur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crta svaku pjesmu tako da njezin najglasniji dio doseže punu visinu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden számot úgy rajzol ki, hogy a leghangosabb része teljes magasságot érjen el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggambar setiap lagu dengan bagian terkerasnya pada tinggi penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna ogni brano con il passaggio più forte a piena altezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各曲の最も大きい部分が最大の高さになるように描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 트랙의 가장 큰 부분이 최대 높이가 되도록 그립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner hvert spor med den høyeste passasjen i full høyde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekent elk nummer met het luidste gedeelte op volle hoogte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysuje każdy utwór tak, aby jego najgłośniejszy fragment sięgał pełnej wysokości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenha cada música com o trecho mais alto na altura máxima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenha cada faixa com a passagem mais alta à altura máxima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenează fiecare piesă cu pasajul cel mai puternic la înălțime maximă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый трек рисуется так, чтобы его самый громкий фрагмент достигал полной высоты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá skladba sa vykreslí tak, aby jej najhlasnejšia časť dosahovala plnú výšku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritar varje spår med det högsta partiet i full höjd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดทุกเพลงโดยให้ช่วงที่ดังที่สุดสูงเต็มที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her parçayı en yüksek sesli bölümü tam yükseklikte olacak şekilde çizer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен трек малюється так, щоб його найгучніший фрагмент сягав повної висоти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ mỗi bài hát sao cho đoạn lớn nhất đạt chiều cao tối đa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制每首曲目时，使其最响的段落达到最大高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製每首曲目時，使其最響的段落達到最大高度。"
          }
        }
      },
      "extractionState": "manual"
    },
