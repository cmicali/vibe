    "settings.advanced.allow_bit_perfect_any_device": {
      "comment": "Settings, Advanced pane: testing switch that permits enabling the bit-perfect output mode on every output transport, including Bluetooth. Use the same term for bit-perfect as the Audio Output pane.",
