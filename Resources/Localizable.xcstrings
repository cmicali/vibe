    "label.favorites.empty.message": {
      "comment": "iOS: explanatory line under the empty favorites headline. It says how a favorite is made: open a folder, then tap the star button on the playlist screen.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете звездата при отворена папка, за да я запазите тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U otevřené složky klepněte na hvězdičku a zůstane tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på stjernen, når en mappe er åben, for at beholde den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem geöffneten Ordner auf den Stern, um ihn hier zu behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε το αστέρι σε έναν ανοιχτό φάκελο για να τον κρατήσετε εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star a folder you have open to keep it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la estrella con una carpeta abierta para guardarla aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kansio täällä napauttamalla tähteä, kun kansio on avoinna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’étoile lorsqu’un dossier est ouvert pour le conserver ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite zvjezdicu kad je mapa otvorena da biste je zadržali ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érintsd meg a csillagot egy megnyitott mappánál, hogy itt maradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk bintang saat folder terbuka untuk menyimpannya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la stella con una cartella aperta per tenerla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを開いた状態で星をタップすると、ここに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 연 상태에서 별을 탭하면 여기에 보관됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på stjernen når en mappe er åpen, for å beholde den her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de ster bij een geopende map om deze hier te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij w gwiazdkę przy otwartym folderze, aby zachować go tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na estrela com uma pasta aberta para mantê‑la aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na estrela com uma pasta aberta para mantê‑la aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți steaua când un dosar este deschis pentru a‑l păstra aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите звёздочку при открытой папке, чтобы сохранить её здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri otvorenom priečinku ťuknite na hviezdičku a zostane tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på stjärnan när en mapp är öppen för att behålla den här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะรูปดาวขณะเปิดโฟลเดอร์อยู่ เพื่อเก็บโฟลเดอร์นั้นไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasör açıkken yıldıza dokunarak klasörü burada tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться зірочки за відкритої папки, щоб зберегти її тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào ngôi sao khi đang mở một thư mục để giữ thư mục đó ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开文件夹后轻点星标，即可保留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開檔案夾後點一下星號，即可保留在這裡。"
          }
        }
      },
      "extractionState": "manual"
    },
