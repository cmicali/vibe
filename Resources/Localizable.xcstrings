    "settings.general.bit_perfect.depth": {
      "comment": "Bit-perfect output status: the file carries more bits per sample than the decoder or the device can pass on, so the audio is truncated. The decoder is 32-bit float, which carries 24 integer bits.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Битовата дълбочина на файла е по-голяма от поддържаната от устройството"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitová hloubka souboru je vyšší, než zařízení dokáže přehrát"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filens bitdybde er større, end enheden kan afspille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bittiefe der Datei ist höher, als das Gerät wiedergeben kann"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βάθος bit του αρχείου υπερβαίνει τις δυνατότητες αναπαραγωγής της συσκευής"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File's bit depth is greater than device can play"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La profundidad de bits del archivo supera la que puede reproducir el dispositivo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedoston bittisyvyys ylittää laitteen toistokyvyn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La profondeur de bits du fichier dépasse les capacités de lecture de l’appareil"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubina bita datoteke veća je nego što uređaj može reproducirati"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl bitmélysége meghaladja az eszköz lejátszási képességét"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedalaman bit file melebihi kemampuan pemutaran perangkat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La profondità di bit del file supera quella riproducibile dal dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのビット深度がデバイスの再生能力を超えています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일의 비트 심도가 기기의 재생 가능 범위를 초과합니다"
