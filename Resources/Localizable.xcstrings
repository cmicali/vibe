    "settings.general.bit_perfect.volume": {
      "comment": "Bit-perfect output status: macOS is scaling the audio in software because the device's volume is below full. %@ is the volume as a whole-number percentage; %% is a literal percent sign.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Силата на звука на устройството е %@%%; задайте 100%% за битово точен изход"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitost zařízení je %@%%; pro bitově přesný výstup ji nastavte na 100%%"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhedens lydstyrke er %@%%; indstil den til 100%% for bitperfekt output"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gerätelautstärke beträgt %@%%; stelle sie für bitgenaue Ausgabe auf 100%%"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ένταση της συσκευής είναι %@%%· ορίστε την στο 100%% για έξοδο bit-perfect"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device's volume is %@%%: set to 100%% for bit-perfect output"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen del dispositivo es del %@%%; ajústalo al 100%% para una salida bit-perfect"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteen äänenvoimakkuus on %@%%; aseta se 100%%:iin bittitarkkaa lähtöä varten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume de l’appareil est à %@%% ; réglez-le sur 100%% pour une sortie bit-perfect"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasnoća uređaja je %@%%; postavite je na 100%% za bitovno točan izlaz"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszköz hangereje %@%%; a bitpontos kimenethez állítsd 100%%-ra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume perangkat adalah %@%%; atur ke 100%% untuk output bit-perfect"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume del dispositivo è al %@%%; impostalo al 100%% per un’uscita bit-perfect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
