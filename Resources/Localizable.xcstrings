    "error.favorite.unavailable": {
      "comment": "iOS: alert message shown when tapping a favorite whose folder could not be found. The alert’s title is the folder’s name. Uses a curly apostrophe (’).",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази папка не може да се отвори в момента. Възможно е да е преместена или изтрита, или облачната ѝ услуга да е отписана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto složku teď nelze otevřít. Mohla být přesunuta či smazána, nebo je její cloudová služba odhlášená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe kan ikke åbnes lige nu. Den er måske flyttet eller slettet, eller dens skytjeneste er logget ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner kann gerade nicht geöffnet werden. Er wurde vielleicht bewegt oder gelöscht, oder sein Cloud‑Dienst ist abgemeldet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος δεν μπορεί να ανοίξει αυτήν τη στιγμή. Ίσως μετακινήθηκε ή διαγράφηκε ή έγινε αποσύνδεση από την υπηρεσία cloud του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder can’t be opened right now. It may have been moved or deleted, or its cloud service may be signed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta no se puede abrir ahora. Puede que se haya movido o eliminado, o que su servicio en la nube tenga la sesión cerrada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kansiota ei voi avata juuri nyt. Se on ehkä siirretty tai poistettu, tai sen pilvipalvelusta on kirjauduttu ulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier ne peut pas être ouvert pour le moment. Il a peut‑être été déplacé ou supprimé, ou vous êtes déconnecté de son service de stockage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovu mapu trenutačno nije moguće otvoriti. Možda je premještena ili izbrisana ili je odjavljena njezina usluga u oblaku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mappa most nem nyitható meg. Lehet, hogy áthelyezted vagy törölted, vagy ki vagy jelentkezve a felhőszolgáltatásából."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini tidak dapat dibuka sekarang. Folder mungkin telah dipindahkan atau dihapus, atau layanan cloud-nya telah keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile aprire questa cartella al momento. Potrebbe essere stata spostata o eliminata, oppure hai effettuato la disconnessione dal suo servizio cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは現在開けません。移動または削除されたか、クラウドサービスからサインアウトしている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더를 지금 열 수 없습니다. 폴더가 이동 또는 삭제되었거나 클라우드 서비스에서 로그아웃되었을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen kan ikke åpnes akkurat nå. Den kan ha blitt flyttet eller slettet, eller skytjenesten er logget av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map kan nu niet worden geopend. Mogelijk is de map verplaatst of verwijderd, of is de clouddienst afgemeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz otworzyć tego folderu. Mógł zostać przeniesiony lub usunięty albo nastąpiło wylogowanie z jego usługi w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível abrir esta pasta agora. Ela pode ter sido movida ou apagada, ou o serviço de nuvem dela pode estar desconectado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível abrir esta pasta agora. Pode ter sido movida ou apagada, ou pode ter terminado sessão no respetivo serviço na nuvem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dosar nu poate fi deschis acum. Este posibil să fi fost mutat sau șters ori să fiți deconectat de la serviciul său cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту папку сейчас нельзя открыть. Возможно, она перемещена или удалена либо выполнен выход из её облачного сервиса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento priečinok sa teraz nedá otvoriť. Mohol byť presunutý alebo vymazaný, prípadne ste odhlásený z jeho cloudovej služby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att öppna den här mappen just nu. Den kan ha flyttats eller raderats, eller så är dess molntjänst utloggad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดโฟลเดอร์นี้ในตอนนี้ไม่ได้ โฟลเดอร์อาจถูกย้ายหรือลบไปแล้ว หรือบริการคลาวด์ของโฟลเดอร์อาจลงชื่อออกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör şu anda açılamıyor. Taşınmış veya silinmiş olabilir ya da bulut servisinin oturumu kapatılmış olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю папку зараз неможливо відкрити. Можливо, її перемістили чи вилучили або виконано вихід із її хмарної служби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể mở thư mục này. Thư mục có thể đã bị di chuyển hoặc xóa, hoặc dịch vụ đám mây của thư mục đã đăng xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法打开此文件夹。它可能已被移动或删除，或者其云服务已退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法打開此檔案夾。它可能已被移動或刪除，或者其雲端服務已登出。"
          }
        }
      },
      "extractionState": "manual"
    },
