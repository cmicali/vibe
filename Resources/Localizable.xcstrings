    "settings.advanced.debug_info_caption": {
      "comment": "Settings, Advanced pane, Build group: hint below Debug info saying what the saved file contains. No trailing period.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазва настройките, аудиоустройствата и журнала от тази сесия за доклад за грешка"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží nastavení, zvuková zařízení a protokol této relace pro hlášení chyby"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiverer indstillinger, lydenheder og loggen fra denne session til en fejlrapport"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert Einstellungen, Audiogeräte und das Protokoll dieser Sitzung für einen Fehlerbericht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύει τις ρυθμίσεις, τις συσκευές ήχου και το αρχείο καταγραφής αυτής της συνεδρίας για αναφορά σφάλματος"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves settings, audio devices, and this session's log for a bug report"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los ajustes, los dispositivos de audio y el registro de esta sesión para un informe de error"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa asetukset, äänilaitteet ja tämän istunnon lokin virheraporttia varten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les réglages, les appareils audio et le journal de cette session pour un rapport de bug"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprema postavke, audiouređaje i zapisnik ove sesije za prijavu pogreške"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Menti a beállításokat, a hangeszközöket és a munkamenet naplóját egy hibajelentéshez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan pengaturan, perangkat audio, dan log sesi ini untuk laporan bug"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva impostazioni, dispositivi audio e il registro di questa sessione per una segnalazione di bug"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、オーディオデバイス、このセッションのログをバグレポート用に保存します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그 보고를 위해 설정, 오디오 기기 및 이 세션의 로그를 저장합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiverer innstillinger, lydenheter og loggen fra denne økten til en feilrapport"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart instellingen, audioapparaten en het logboek van deze sessie voor een foutmelding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje ustawienia, urządzenia audio i dziennik tej sesji do zgłoszenia błędu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva os ajustes, os dispositivos de áudio e o registro desta sessão para um relatório de erro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as definições, os dispositivos de áudio e o registo desta sessão para um relatório de erro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează setările, dispozitivele audio și jurnalul acestei sesiuni pentru un raport de eroare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет настройки, аудиоустройства и журнал этого сеанса для отчета об ошибке"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží nastavenia, zvukové zariadenia a denník tejto relácie pre hlásenie chyby"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar inställningar, ljudenheter och loggen från den här sessionen för en felrapport"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการตั้งค่า อุปกรณ์เสียง และบันทึกของเซสชันนี้สำหรับรายงานข้อบกพร่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata raporu için ayarları, ses aygıtlarını ve bu oturumun günlüğünü kaydeder"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає налаштування, аудіопристрої та журнал цього сеансу для звіту про помилку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu cài đặt, thiết bị âm thanh và nhật ký của phiên này để báo cáo lỗi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储设置、音频设备和此会话的日志，用于错误报告"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存設定、音訊裝置和此工作階段的記錄，以用於錯誤回報"
          }
        }
      },
      "extractionState": "manual"
    },
