    "settings.permissions.folder_grant.message": {
      "comment": "Message atop the folder-picker panel opened from the Add Common Folder menu, which starts in the chosen folder. %1$@ is the app name, %2$@ that folder's name, e.g. 'Documents'.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете на %1$@ достъп до „%2$@“, за да може да чете музика навсякъде в нея."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte %1$@ přístup ke složce „%2$@“, aby mohl číst hudbu kdekoli v ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv %1$@ adgang til “%2$@”, så appen kan læse musik overalt i den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube %1$@ den Zugriff auf „%2$@“, damit die App überall darin Musik lesen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραχωρήστε στο %1$@ πρόσβαση στον φάκελο «%2$@», ώστε να μπορεί να διαβάζει μουσική οπουδήποτε μέσα σε αυτόν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant %1$@ access to “%2$@”, so it can read music anywhere inside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que %1$@ acceda a “%2$@” para que pueda leer música en cualquier lugar dentro de esa carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli %1$@n pääsy kansioon ”%2$@”, jotta se voi lukea musiikkia kaikkialta sen sisältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez %1$@ à accéder à « %2$@ » afin qu’il puisse y lire la musique où qu’elle se trouve."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite %1$@u pristup mapi „%2$@”, kako bi mogao čitati glazbu bilo gdje u njoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a %1$@ hozzáférését a(z) „%2$@” mappához, hogy bárhol olvashassa benne a zenét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri %1$@ akses ke “%2$@” agar dapat membaca musik di mana pun di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a %1$@ di accedere a “%2$@”, così può leggere la musica ovunque al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%2$@」内のどこにある音楽でも読み込めるよう、%1$@にアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%2$@’ 폴더 어디에 있는 음악이든 읽을 수 있도록 %1$@에 접근을 허용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi %1$@ tilgang til «%2$@», slik at appen kan lese musikk hvor som helst i den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen %1$@ toegang tot ‘%2$@’, zodat de app overal daarin muziek kan lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udziel %1$@ dostępu do folderu „%2$@”, aby mógł odczytywać muzykę w dowolnym miejscu w nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda ao %1$@ acesso a “%2$@” para que ele possa ler músicas em qualquer lugar dentro dessa pasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda ao %1$@ acesso a “%2$@” para que possa ler música em qualquer local dentro dessa pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți-i lui %1$@ accesul la dosarul „%2$@”, ca să poată citi muzica de oriunde din interiorul lui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите %1$@ доступ к папке «%2$@», чтобы приложение могло читать музыку в любом ее месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte %1$@ prístup k priečinku „%2$@“, aby mohol čítať hudbu kdekoľvek v ňom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge %1$@ åtkomst till ”%2$@” så att appen kan läsa musik var som helst i den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ %1$@ เข้าถึง “%2$@” เพื่อให้อ่านเพลงได้จากทุกที่ภายในโฟลเดอร์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçindeki her yerde müzik okuyabilmesi için %1$@’a “%2$@” klasörüne erişim izni verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте %1$@ доступ до папки «%2$@», щоб застосунок міг читати музику будь-де в ній."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cấp cho %1$@ quyền truy cập “%2$@” để ứng dụng có thể đọc nhạc ở bất kỳ đâu bên trong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 %1$@ 访问“%2$@”，以便读取其中任意位置的音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 %1$@ 取用「%2$@」，以便讀取其中任何位置的音樂。"
          }
        }
      },
      "extractionState": "manual"
    },
