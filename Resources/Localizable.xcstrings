    "menu.file.close": {
      "comment": "File menu item: unloads the current track. Becomes 'Close All Files' when more than one is loaded — two independent strings, not a plural; the count is never shown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close File"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer le fichier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi file"
          }
        }
      }
    },
