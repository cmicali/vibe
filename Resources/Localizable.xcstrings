    "settings.permissions.explain": {
      "comment": "Settings, Files pane: explanatory text above the list of granted folders.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете често използваните, за да избегнете повтарящи се заявки за разрешение. Премахването на достъпа не изтрива файлове."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte ty, které používáte často, abyste se vyhnuli opakovaným žádostem o oprávnění. Odebráním přístupu se soubory nesmažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj dem, du bruger ofte, så du undgår gentagne anmodninger om tilladelse. Fjernelse af adgang sletter ikke filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Ordner hinzu, die du oft verwendest, um wiederholte Berechtigungsanfragen zu vermeiden. Das Entfernen des Zugriffs löscht keine Dateien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε όσους χρησιμοποιείτε συχνά, για να αποφύγετε τα επαναλαμβανόμενα αιτήματα άδειας. Η αφαίρεση της πρόσβασης δεν διαγράφει αρχεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add folders to avoid repeated permission prompts. Removing access does not delete files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las que uses a menudo para evitar solicitudes de permiso repetidas. Eliminar el acceso no elimina los archivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää usein käyttämäsi kansiot, niin vältät toistuvat käyttöoikeuspyynnöt. Käyttöoikeuden poistaminen ei poista tiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ceux que vous utilisez souvent pour éviter les demandes d’autorisation répétées. La suppression de l’accès ne supprime pas les fichiers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte one koje često koristite kako biste izbjegli ponavljajuće zahtjeve za dozvolu. Uklanjanje pristupa ne briše datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá azokat, amelyeket gyakran használsz, így elkerülöd az ismétlődő engedélykéréseket. A hozzáférés eltávolítása nem törli a fájlokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan folder yang sering Anda gunakan untuk menghindari permintaan izin berulang. Menghapus akses tidak menghapus file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi quelle che usi spesso per evitare richieste di autorizzazione ripetute. Rimuovere l’accesso non elimina i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うフォルダを追加すると、繰り返しアクセス許可を求められずに済みます。アクセスを削除してもファイルは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 사용하는 폴더를 추가하면 권한 요청이 반복되지 않습니다. 접근 권한을 제거해도 파일은 삭제되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til dem du bruker ofte, så slipper du gjentatte tillatelsesforespørsler. Fjerning av tilgang sletter ikke filer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de mappen toe die je vaak gebruikt, zo voorkom je herhaalde toestemmingsvragen. Het verwijderen van toegang verwijdert geen bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj te, z których korzystasz często, aby uniknąć powtarzających się próśb o uprawnienia. Usunięcie dostępu nie usuwa plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as que você usa com frequência para evitar pedidos de permissão repetidos. Remover o acesso não apaga os arquivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as que utiliza com frequência para evitar pedidos de permissão repetidos. Remover o acesso não apaga os ficheiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați-le pe cele pe care le folosiți des, pentru a evita solicitările repetate de permisiune. Eliminarea accesului nu șterge fișierele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте те, которыми вы часто пользуетесь, чтобы не отвечать на повторяющиеся запросы разрешений. Удаление доступа не удаляет файлы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte tie, ktoré používate často, aby ste sa vyhli opakovaným žiadostiam o povolenie. Odstránením prístupu sa súbory nevymažú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till de mappar du använder ofta så slipper du upprepade behörighetsfrågor. Filer raderas inte när åtkomsten tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มโฟลเดอร์เพื่อหลีกเลี่ยงการขอสิทธิ์ซ้ำ ๆ การเอาสิทธิ์การเข้าถึงออกจะไม่ลบไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kullandıklarınızı ekleyerek tekrarlanan izin isteklerinden kurtulun. Erişimi kaldırmak dosyaları silmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте ті, якими ви часто користуєтеся, щоб уникнути повторних запитів на дозвіл. Вилучення доступу не видаляє файли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm những thư mục bạn hay dùng để tránh phải cấp quyền nhiều lần. Xóa quyền truy cập không xóa tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加常用的文件夹，即可避免反复出现权限请求。移除访问权限不会删除文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入常用的檔案夾，即可避免重複出現權限請求。移除存取權限不會刪除檔案。"
          }
        }
      },
      "extractionState": "manual"
    },
