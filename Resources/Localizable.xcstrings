            "state": "translated",
            "value": "Valitse, minne muunnettu FLAC-tiedosto tallennetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où enregistrer le FLAC converti."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite gdje želite spremiti konvertiranu FLAC datoteku."
