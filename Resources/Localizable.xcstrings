    "settings.appearance.theme.album_art_requirements": {
      "comment": "Alert detail under the invalid-image title, stating every requirement.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображението трябва да е квадратен JPEG или PNG, между 64 и 4096 пиксела, под 8 МБ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek musí být čtvercový JPEG nebo PNG, 64 až 4096 pixelů, do 8 MB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet skal være et kvadratisk JPEG eller PNG, mellem 64 og 4096 pixels, under 8 MB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild muss ein quadratisches JPEG oder PNG sein, zwischen 64 und 4096 Pixeln, unter 8 MB."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εικόνα πρέπει να είναι τετράγωνη JPEG ή PNG, από 64 έως 4096 pixel, κάτω από 8 MB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image must be a square JPEG or PNG, between 64 and 4096 pixels, under 8 MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen debe ser un JPEG o PNG cuadrado, de entre 64 y 4096 píxeles, de menos de 8 MB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvan on oltava neliömäinen JPEG tai PNG, 64–4096 pikseliä, alle 8 Mt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image doit être un JPEG ou PNG carré, entre 64 et 4096 pixels, de moins de 8 Mo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika mora biti kvadratni JPEG ili PNG, između 64 i 4096 piksela, ispod 8 MB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képnek négyzet alakú JPEG-nek vagy PNG-nek kell lennie, 64 és 4096 pixel között, 8 MB alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar harus JPEG atau PNG persegi, antara 64 dan 4096 piksel, di bawah 8 MB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’immagine deve essere un JPEG o PNG quadrato, tra 64 e 4096 pixel, sotto gli 8 MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は正方形のJPEGまたはPNGで、64〜4096ピクセル、8 MB未満である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지는 정사각형 JPEG 또는 PNG여야 하며, 64~4096픽셀, 8MB 미만이어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet må være et kvadratisk JPEG eller PNG, mellom 64 og 4096 piksler, under 8 MB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afbeelding moet een vierkante JPEG of PNG zijn, tussen 64 en 4096 pixels, kleiner dan 8 MB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazek musi być kwadratowym plikiem JPEG lub PNG, od 64 do 4096 pikseli, poniżej 8 MB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem deve ser um JPEG ou PNG quadrado, entre 64 e 4096 pixels, com menos de 8 MB."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem deve ser um JPEG ou PNG quadrado, entre 64 e 4096 píxeis, com menos de 8 MB."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea trebuie să fie un JPEG sau PNG pătrat, între 64 și 4096 de pixeli, sub 8 MB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение должно быть квадратным JPEG или PNG, от 64 до 4096 пикселей, менее 8 МБ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázok musí byť štvorcový JPEG alebo PNG, 64 až 4096 pixelov, do 8 MB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden måste vara en kvadratisk JPEG eller PNG, mellan 64 och 4096 pixlar, under 8 MB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพต้องเป็น JPEG หรือ PNG จัตุรัส ขนาด 64 ถึง 4096 พิกเซล และเล็กกว่า 8 MB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel kare bir JPEG veya PNG olmalı, 64 ile 4096 piksel arasında ve 8 MB altında olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення має бути квадратним JPEG або PNG, від 64 до 4096 пікселів, менш ніж 8 МБ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh phải là JPEG hoặc PNG vuông, từ 64 đến 4096 pixel, dưới 8 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像必须是正方形的JPEG或PNG，64至4096像素，小于8 MB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖像必須是正方形的JPEG或PNG，64至4096像素，小於8 MB。"
          }
        }
      },
      "extractionState": "manual"
    },
