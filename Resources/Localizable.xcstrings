    "settings.appearance.single_caption": {
      "comment": "macOS Settings: caption explaining that a single-palette theme keeps the window in dark appearance.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази тема използва една палитра и запазва тъмния изглед на прозореца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento motiv používá jednu paletu a zachovává tmavý vzhled okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tema bruger én palet og holder vinduet mørkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Thema verwendet eine Farbpalette und zeigt das Fenster immer dunkel an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το θέμα χρησιμοποιεί μία παλέτα και διατηρεί τη σκούρα εμφάνιση του παραθύρου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This theme uses one palette and keeps the window in dark appearance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema usa una sola paleta y mantiene la ventana con apariencia oscura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä teema käyttää yhtä palettia ja pitää ikkunan ulkoasun tummana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème utilise une seule palette et conserve l’apparence sombre de la fenêtre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova tema koristi jednu paletu i zadržava tamni izgled prozora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a téma egyetlen palettát használ, és sötéten tartja az ablakot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ini menggunakan satu palet dan mempertahankan tampilan gelap jendela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tema usa una sola tavolozza e mantiene la finestra con aspetto scuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは1つのパレットを使用し、ウインドウをダークの外観に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마는 하나의 팔레트를 사용하며 윈도우를 다크 모드로 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette temaet bruker én palett og beholder mørkt vindusutseende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit thema gebruikt één palet en houdt het venster donker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten motyw używa jednej palety i zachowuje ciemny wygląd okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema usa uma única paleta e mantém a janela com aparência escura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema usa uma única paleta e mantém a janela com aparência escura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această temă folosește o singură paletă și păstrează aspectul întunecat al ferestrei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тема использует одну палитру и сохраняет тёмное оформление окна."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento motív používa jednu paletu a zachováva tmavý vzhľad okna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här temat använder en palett och behåller fönstrets mörka utseende."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธีมนี้ใช้ชุดสีเดียวและคงรูปลักษณ์มืดของหน้าต่างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tema tek bir palet kullanır ve pencereyi koyu görünümde tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця тема використовує одну палітру та зберігає темний вигляд вікна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề này dùng một bảng màu và giữ giao diện tối cho cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主题使用单一调色板，并保持窗口的深色外观。"
