    "playlist.grant.message": {
      "comment": "Message atop the folder-picker panel shown when a playlist file's (CUE, M3U) audio files are not readable under the sandbox. %1$@ is the app name, %2$@ the playlist file's name.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ се нуждае от разрешение, за да чете аудиофайловете, изброени в „%2$@“. Изберете папката, която ги съдържа."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ potřebuje oprávnění ke čtení zvukových souborů uvedených v „%2$@“. Vyberte složku, která je obsahuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ skal have tilladelse til at læse lydfilerne i “%2$@”. Vælg den mappe, der indeholder dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt die Berechtigung, die in „%2$@“ aufgeführten Audiodateien zu lesen. Wähle den Ordner aus, der sie enthält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ χρειάζεται άδεια για να διαβάσει τα αρχεία ήχου που αναφέρονται στο «%2$@». Επιλέξτε τον φάκελο που τα περιέχει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ needs permission to read the audio files listed in “%2$@”. Select the folder that contains them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ necesita permiso para leer los archivos de audio listados en “%2$@”. Selecciona la carpeta que los contiene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarvitsee luvan lukea tiedostossa ”%2$@” lueteltuja äänitiedostoja. Valitse kansio, joka sisältää ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a besoin de l’autorisation de lire les fichiers audio listés dans « %2$@ ». Sélectionnez le dossier qui les contient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ treba dozvolu za čitanje audiodatoteka navedenih u „%2$@”. Odaberite mapu koja ih sadrži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %1$@-nak engedélyre van szüksége a(z) „%2$@” fájlban felsorolt hangfájlok olvasásához. Válaszd ki a mappát, amely tartalmazza őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ memerlukan izin untuk membaca file audio yang tercantum di “%2$@”. Pilih folder yang berisi file tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha bisogno del permesso di leggere i file audio elencati in “%2$@”. Seleziona la cartella che li contiene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が「%2$@」に記載されているオーディオファイルを読み込むには許可が必要です。それらを含むフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@가 ‘%2$@’에 나열된 오디오 파일을 읽으려면 권한이 필요합니다. 해당 파일이 들어 있는 폴더를 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trenger tillatelse til å lese lydfilene i «%2$@». Velg mappen som inneholder dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft toestemming nodig om de audiobestanden in ‘%2$@’ te lezen. Selecteer de map waarin ze staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ potrzebuje uprawnienia do odczytu plików audio wymienionych w „%2$@”. Wybierz folder, który je zawiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ precisa de permissão para ler os arquivos de áudio listados em “%2$@”. Selecione a pasta que os contém."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ precisa de permissão para ler os ficheiros de áudio listados em “%2$@”. Selecione a pasta que os contém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ are nevoie de permisiune pentru a citi fișierele audio listate în „%2$@”. Selectați dosarul care le conține."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ требуется разрешение на чтение аудиофайлов, перечисленных в «%2$@». Выберите папку, в которой они находятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ potrebuje povolenie na čítanie zvukových súborov uvedených v „%2$@“. Vyberte priečinok, ktorý ich obsahuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ behöver behörighet att läsa ljudfilerna i ”%2$@”. Välj mappen som innehåller dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ต้องการสิทธิ์ในการอ่านไฟล์เสียงที่ระบุไว้ใน “%2$@” โปรดเลือกโฟลเดอร์ที่มีไฟล์เหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@’ın “%2$@” içinde listelenen ses dosyalarını okumak için izne ihtiyacı var. Onları içeren klasörü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ потребує дозволу на читання аудіофайлів, перелічених у «%2$@». Виберіть папку, яка їх містить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cần quyền để đọc các tệp âm thanh được liệt kê trong “%2$@”. Hãy chọn thư mục chứa chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要权限来读取“%2$@”中列出的音频文件。请选择包含这些文件的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要權限才能讀取「%2$@」中列出的音訊檔案。請選擇包含這些檔案的檔案夾。"
          }
        }
      },
      "extractionState": "manual"
    },
