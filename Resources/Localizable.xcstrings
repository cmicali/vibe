{
  "sourceLanguage": "en",
  "strings": {
    "a11y.playlist.toggle": {
      "comment": "Accessibility label for the button that shows and hides the playlist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle Playlist"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titelliste ein-/ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar u ocultar la lista de reproducción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher/masquer la liste de lecture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nascondi la playlist"
          }
        }
      }
    },
    "a11y.window.close": {
      "comment": "Accessibility label for the window's close button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi"
          }
        }
      }
    },
    "a11y.window.minimize": {
      "comment": "Accessibility label for the window's minimize button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimize"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Dock ablegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimizar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer dans le Dock"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci nel Dock"
          }
        }
      }
    },
    "app.name": {
      "comment": "The application's name, as shown in the app menu and as the window title. A product name — translate only if it would otherwise be unreadable in the target script.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe"
          }
        }
      }
    },
    "error.device_unavailable": {
      "comment": "Inline playback error: no usable audio output device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio device unavailable"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiogerät nicht verfügbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo de audio no disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Périphérique audio indisponible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo audio non disponibile"
          }
        }
      }
    },
    "error.engine_start_failed": {
      "comment": "Inline playback error: the audio engine failed to start.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start playback"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe konnte nicht gestartet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la reproducción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la lecture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la riproduzione"
          }
        }
      }
    },
    "error.load_timeout": {
      "comment": "Inline playback error: opening the file took too long, e.g. an undownloaded cloud file.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load timed out"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim Laden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de carga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai de chargement dépassé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeout di caricamento"
          }
        }
      }
    },
    "error.open_failed": {
      "comment": "Inline playback error: the audio file could not be opened.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open file"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht geöffnet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le fichier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il file"
          }
        }
      }
    },
    "error.playback_generic": {
      "comment": "Inline playback error: fallback for an unrecognized failure.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback error"
          }
        },
        "de": {
          "stringUnit": {
