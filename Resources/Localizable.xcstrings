    "label.convert.save_message": {
      "comment": "Message atop the save panel that appears when the app may not write next to the source file.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете къде да запазите конвертирания FLAC файл."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kam uložit převedený soubor FLAC."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvor den konverterede FLAC-fil skal arkiveres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wo die konvertierte FLAC-Datei gesichert werden soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πού θα αποθηκευτεί το FLAC της μετατροπής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to save the converted FLAC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde guardar el FLAC convertido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, minne muunnettu FLAC-tiedosto tallennetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où enregistrer le FLAC converti."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite gdje želite spremiti konvertiranu FLAC datoteku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, hová mentsük a konvertált FLAC-fájlt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih lokasi untuk menyimpan FLAC hasil konversi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove salvare il FLAC convertito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換したFLACファイルの保存先を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환된 FLAC 파일을 저장할 위치를 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor den konverterte FLAC-filen skal arkiveres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar je de geconverteerde FLAC wilt bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie zachować przekonwertowany plik FLAC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde salvar o FLAC convertido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde guardar o ficheiro FLAC convertido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți unde să salvați fișierul FLAC convertit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, куда сохранить конвертированный файл FLAC."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kam uložiť skonvertovaný súbor FLAC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj var den konverterade FLAC-filen ska sparas."
          }
        },
        "th": {
