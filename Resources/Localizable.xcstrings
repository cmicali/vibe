        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lejátszási útvonal megváltoztatja a fájl csatornáinak számát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalur pemutaran mengubah jumlah kanal file ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso di riproduzione modifica il numero di canali di questo file"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生経路でこのファイルのチャンネル数が変更されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 경로에서 이 파일의 채널 수가 변경됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avspillingskjeden endrer antall kanaler i denne filen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afspeelpad wijzigt het aantal kanalen van dit bestand"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor odtwarzania zmienia liczbę kanałów tego pliku"
          }
        },
        "pt-BR": {
