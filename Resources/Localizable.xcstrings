    "settings.advanced.factory_reset_caption": {
      "comment": "Settings, Advanced pane: hint below Factory reset; custom themes are deleted as well as resetting settings.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връща фабричните настройки, включително изтриване на персонализираните теми."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví tovární nastavení a smaže vlastní motivy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulstiller til fabriksindstillingerne og sletter tilpassede temaer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt auf die Werkseinstellungen zurück und löscht eigene Designs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει τις εργοστασιακές ρυθμίσεις και διαγράφει τα προσαρμοσμένα θέματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to factory defaults, including deleting custom themes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece los ajustes de fábrica y elimina los temas personalizados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa tehdasasetukset ja poistaa omat teemat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les réglages d’usine et supprime les thèmes personnalisés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća tvorničke postavke i briše prilagođene teme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a gyári beállításokat, és törli az egyéni témákat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur ulang ke pengaturan pabrik dan menghapus tema khusus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina le impostazioni di fabbrica ed elimina i temi personalizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "工場出荷時の設定に戻し、カスタムテーマも削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기 설정으로 재설정하고 사용자 설정 테마를 삭제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakestiller til fabrikkinnstillingene og sletter egendefinerte temaer."
          }
        },
        "nl": {
          "stringUnit": {
