    "settings.general.bit_perfect.idle": {
      "comment": "Settings, Audio pane: caption under the bit-perfect output switch while it is on and playback is stopped or paused.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включен. Нищо не се възпроизвежда."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuto. Nic se nepřehrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til. Intet afspilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein. Keine Wiedergabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργή. Δεν αναπαράγεται τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: nothing playing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activada. No se está reproduciendo nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päällä. Mitään ei toisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activée. Aucune lecture en cours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključeno. Ništa se ne reproducira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva. Nincs lejátszás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala. Tidak ada yang diputar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva. Nessuna riproduzione in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン。再生していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬. 재생 중인 항목이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På. Ingenting spilles av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan. Er wordt niets afgespeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone. Nic nie jest odtwarzane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativada. Nada está sendo reproduzido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativada. Nada está a ser reproduzido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activată. Nu se redă nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён. Ничего не воспроизводится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuté. Nič sa neprehráva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På. Inget spelas upp."
