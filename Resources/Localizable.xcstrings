    "settings.convert.delete_original": {
      "comment": "Settings, Files pane, FLAC conversion group: checkbox — when on, a successful conversion moves the original file to the Trash. The same setting as the Convert menu's 'Delete Original After Convert' item, in sentence case per checkbox convention.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преместване на оригинала в Кошчето след конвертиране"
          }
        },
        "cs": {
