    "settings.permissions.folder.unavailable.tip": {
      "comment": "Settings, Files pane, granted-folder list: tooltip on a dimmed row, explaining why an unreachable folder is still listed. %@ is the app name. Uses a curly apostrophe (’).",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази папка липсва или е на диск, който не е свързан. %@ запазва разрешението и ще я използва отново, ако се появи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato složka chybí nebo je na disku, který není připojen. %@ si oprávnění ponechá a použije ji znovu, až bude dostupná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe mangler eller ligger på en disk, der ikke er tilsluttet. %@ beholder tilladelsen og bruger den igen, hvis den kommer tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner fehlt oder liegt auf einem nicht verbundenen Volume. %@ behält die Berechtigung und verwendet ihn wieder, sobald er verfügbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος λείπει ή βρίσκεται σε δίσκο που δεν είναι συνδεδεμένος. Το %@ διατηρεί την άδεια και θα τον χρησιμοποιήσει ξανά αν επανέλθει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is missing, or on a disk that isn’t connected. %@ keeps its permission and will use it again if it comes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta no existe o está en un disco que no está conectado. %@ conserva su permiso y volverá a usarla si reaparece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kansio puuttuu tai on levyllä, joka ei ole yhdistettynä. %@ säilyttää käyttöoikeuden ja käyttää kansiota taas, jos se palaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est introuvable ou se trouve sur un disque non connecté. %@ conserve son autorisation et l’utilisera de nouveau s’il redevient disponible."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova mapa nedostaje ili se nalazi na disku koji nije spojen. %@ zadržava dozvolu i ponovno će je koristiti ako se mapa vrati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mappa hiányzik, vagy egy nem csatlakoztatott lemezen van. A %@ megtartja az engedélyt, és újra használni fogja, ha a mappa visszatér."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini hilang atau berada di disk yang tidak terhubung. %@ menyimpan izinnya dan akan menggunakannya lagi jika folder kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella non esiste o si trova su un disco non collegato. %@ ne conserva l’autorizzazione e la userà di nuovo quando tornerà disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは見つからないか、接続されていないディスク上にあります。%@はアクセス権を保持し、フォルダが戻れば再び使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더가 없거나 연결되지 않은 디스크에 있습니다. %@는 권한을 유지하며 폴더가 다시 나타나면 다시 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen mangler eller ligger på en disk som ikke er tilkoblet. %@ beholder tillatelsen og bruker den igjen hvis den kommer tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map ontbreekt of staat op een schijf die niet is verbonden. %@ behoudt de toestemming en gebruikt de map weer zodra die terug is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder nie istnieje lub znajduje się na niepodłączonym dysku. %@ zachowuje uprawnienie i użyje go ponownie, gdy folder wróci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta está ausente ou em um disco que não está conectado. O %@ mantém a permissão e voltará a usá-la se ela reaparecer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta não existe ou está num disco que não está ligado. O %@ mantém a permissão e voltará a usá-la se ela reaparecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dosar lipsește sau se află pe un disc neconectat. %@ își păstrează permisiunea și îl va folosi din nou dacă revine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка отсутствует или находится на неподключенном диске. %@ сохраняет разрешение и снова использует ее, когда она появится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento priečinok chýba alebo je na disku, ktorý nie je pripojený. %@ si oprávnenie ponechá a použije ho znova, keď bude dostupný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen saknas eller finns på en disk som inte är ansluten. %@ behåller behörigheten och använder den igen om den kommer tillbaka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้หายไปหรืออยู่ในดิสก์ที่ไม่ได้เชื่อมต่อ %@ จะเก็บสิทธิ์ไว้และจะใช้อีกครั้งเมื่อโฟลเดอร์กลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör eksik veya bağlı olmayan bir diskte. %@ iznini korur ve klasör geri gelirse yeniden kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка відсутня або розташована на непідключеному диску. %@ зберігає дозвіл і знову використає її, коли вона з’явиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này bị thiếu hoặc nằm trên ổ đĩa chưa được kết nối. %@ giữ lại quyền truy cập và sẽ dùng lại khi thư mục xuất hiện trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹缺失，或位于未连接的磁盘上。%@ 会保留其权限，文件夹恢复后将继续使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾遺失，或位於未連接的磁碟上。%@ 會保留其權限，檔案夾恢復後將繼續使用。"
          }
        }
      },
      "extractionState": "manual"
    },
