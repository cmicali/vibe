{
  "version": 1,
  "name": "Record Bin",
  "description": "A single-mode black window with no glass: the 3-Band waveform drawn flat, key colors in the readouts, and a soft white volume bar.",
  "window": {
    "backgroundColorDark": "#000000",
    "backgroundStyle": "solid",
    "cornerRadius": 4,
    "customCornerRadius": true,
    "mode": "single",
    "tint": "mono"
  },
  "info": {
    "keyColorsEnabled": true
  },
  "waveform": {
    "gradient": false,
    "style": "three_band"
  },
  "volume": {
    "bar": "custom",
    "barColorDark": "#FFFFFFD0"
  }
}
