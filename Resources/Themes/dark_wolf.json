{
  "version": 2,
  "name": "Dark Wolf",
  "description": "Contributed by JohnnyFireOne (#183). A dark teal window with red and amber waveform bars.",
  "window": {
    "appIconShape": false,
    "backgroundColorDark": "#1E1E1E",
    "mode": "single",
    "tint": "custom",
    "tintColorDark": "#1C2F31"
  },
  "player": {
    "artistColorDark": "#438681",
    "artistFontFace": "HelveticaNeue-Medium",
    "artistFontSize": 18,
    "nextButtonColorDark": "#E7D396",
    "nextButtonGlyph": "arrow.right.circle.fill",
    "pauseButtonGlyph": "pause.circle.fill",
    "playButtonColorDark": "#E7D396",
    "playButtonGlyph": "play.circle.fill",
    "playlistButtonColorDark": "#E7D396",
    "playlistButtonGlyph": "music.note.list",
    "showTransportButtons": false,
    "titleColorDark": "#71A08C",
    "titleFontFace": "HelveticaNeue-Medium",
    "titleFontSize": 20
  },
  "info": {
    "colorDark": "#D54532",
