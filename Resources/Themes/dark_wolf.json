    "backgroundColorDark": "#1E1E1E",
    "durationColorEnabled": true,
    "durationFontFace": "HelveticaNeue-Medium",
    "durationFontSize": 14,
    "equalizerColorDark": "#FDF1B6",
    "fontFace": "HelveticaNeue-Medium",
    "fontSize": 16,
    "numberColorEnabled": true,
    "playingRowArtistColorDark": "#438681",
    "playingRowArtistColorEnabled": true,
    "playingRowColorDark": "#37717540",
    "playingRowDurationColorDark": "#438681",
    "playingRowDurationColorEnabled": true,
    "playingRowNumberColorDark": "#438681",
    "playingRowNumberColorEnabled": true,
    "playingRowTitleColorDark": "#71A08C",
    "playingRowTitleColorEnabled": true,
    "selectedRowArtistColorDark": "#D54532",
    "selectedRowArtistColorEnabled": true,
    "selectedRowColorDark": "#3771757F",
    "selectedRowDurationColorDark": "#FCA931",
    "selectedRowDurationColorEnabled": true,
    "selectedRowNumberColorDark": "#D54532",
    "selectedRowNumberColorEnabled": true,
    "selectedRowTitleColorDark": "#FCA931",
    "selectedRowTitleColorEnabled": true,
    "tint": "custom",
    "tintColorDark": "#192B2DBF",
    "titleColorDark": "#71A08C",
    "titleColorEnabled": true
