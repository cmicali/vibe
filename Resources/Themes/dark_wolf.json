    "durationFontFace": "HelveticaNeue-Medium",
    "durationFontSize": 14,
    "fontFace": "HelveticaNeue-Medium",
    "fontSize": 16,
    "numberColorEnabled": true,
    "playingRowColorDark": "#37717540",
    "selectedRowColorDark": "#3771757F",
    "tint": "custom",
    "tintColorDark": "#192B2DBF",
    "titleColorDark": "#71A08C",
    "titleColorEnabled": true
